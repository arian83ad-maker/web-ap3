{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ap3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6406f754-445d-4b52-ac91-ba1ed9c66901","database_name": "web123" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ceb3648a605e43e799f6bd97fc1a99df" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
